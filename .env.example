# Copy this file to .env for local development.
# On Render, set these same keys in the dashboard under
# Environment instead of using this file.

ENVIRONMENT=development

# ── Supabase ──
# Found in Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Firebase ──
# Generate at: Firebase Console > Project Settings > Service Accounts >
# Generate New Private Key. Paste the ENTIRE JSON file content as one
# line below (escape nothing — most platforms accept raw multi-line
# JSON in an env var value).
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# Alternative for local dev: point to the downloaded JSON file instead
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── Gemini ──
# Found in Google AI Studio > Get API Key
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── CORS ──
# Comma-separated list of allowed origins in production, or "*" for dev
CORS_ORIGINS=*

# ── Limits ──
FREE_TIER_DAILY_SCAN_LIMIT=5
